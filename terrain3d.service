[Unit]
Description=Terrain 3D Testing Server
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ecodash/private/terrain-3d
Environment="PATH=/var/www/ecodash/private/terrain-3d/venv/bin"
ExecStart=/var/www/ecodash/private/terrain-3d/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5001 server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target